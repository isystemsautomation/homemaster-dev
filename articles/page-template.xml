xml<!--
  QWeb arch_base template for HomeMaster /build/* articles.

  n8n fetches this file and substitutes:
    ___VIEW_KEY___   the view's key (e.g. "website.smart-chimney-microplc")
    ___BODY___       the article HTML body (XHTML-cleaned by n8n)
    ___SCHEMAS___    JSON-LD <script> blocks joined with newlines

  Tweak the wrapper structure here to change ALL articles at once:
    - <section class="...">   background, padding, color level
    - <div class="container"> width
    - add <div class="row"><div class="col-lg-10 mx-auto"> if you want narrow reading
-->
<t t-name="___VIEW_KEY___">
    <t t-call="website.layout">
        <div id="wrap" class="oe_structure">
            <section class="s_text_block o_cc o_cc1 o_colored_level pt48 pb48">
                <div class="container">
___BODY___
                </div>
            </section>
___SCHEMAS___
        </div>
    </t>
</t>
